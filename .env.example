# LIGHT CODE — copy this file to .env and fill it in privately.
# Never commit .env or share BOT_TOKEN, database passwords, or session secrets.

# Discord application (all IDs are Discord snowflakes)
BOT_TOKEN=
CLIENT_ID=
OWNER_ID=

# Core commands and presence
DEFAULT_PREFIX=!
BOT_STATUS=online
BOT_ACTIVITY_TYPE=Playing
BOT_ACTIVITY_TEXT=Light Code

# Runtime and observability
NODE_ENV=production
LOG_LEVEL=info

# Storage / dashboard (not active in the current bot build)
DATABASE_URL=
REDIS_URL=
DASHBOARD_URL=https://your-dashboard-domain.example
SESSION_SECRET=

# Music / Lavalink connection settings
# Music transport is not implemented yet; these values only prepare configuration.
MUSIC_ENABLED=false
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
MUSIC_DEFAULT_VOLUME=50
MUSIC_DEFAULT_SEARCH_SOURCE=ytsearch
MUSIC_PLAYLIST_URL=
MUSIC_MAX_QUEUE_SIZE=100

# Optional integrations
MINECRAFT_SERVER_IP=
SUPPORT_SERVER_URL=
